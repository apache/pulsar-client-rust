# The files Apache RAT skips: regular expressions, each matched against a file's or a directory's name. Every other
# file carries the ASF license header.

\.gitignore
# Generated by Cargo.
Cargo\.lock
# Test vectors that tools/java-vectors generates from the Java client. JSON has no comments.
checkpoint\.json
message_id\.json
routing\.json
# Build output, when RAT runs on a tree that was built.
target
